# Copy to .env.local and fill in the provider settings locally. Never commit the key.
MODEL_API_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=anthropic/claude-opus-5.5
MODEL_API_KEY=
# Required for public Vercel deployment (at least 24 random characters).
# Leave empty for local development without the reviewer access gate.
DEMO_ACCESS_CODE=
# Set if your custom production domain differs from Vercel's provided domains.
APP_ORIGIN=
